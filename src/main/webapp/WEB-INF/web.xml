<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.gymmax.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ContactoServlet</servlet-name>
        <servlet-class>com.gymmax.controller.ContactoServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogoutController</servlet-name>
        <servlet-class>com.gymmax.controller.LogoutController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RegistroServlet</servlet-name>
        <servlet-class>com.gymmax.controller.RegistroServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CarritoServlet</servlet-name>
        <servlet-class>com.gymmax.controller.CarritoServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PagoServlet</servlet-name>
        <servlet-class>com.gymmax.controller.PagoServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ReservaServlet</servlet-name>
        <servlet-class>com.gymmax.controller.ReservaServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminSociosServlet</servlet-name>
        <servlet-class>com.gymmax.controller.AdminSociosServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminClasesServlet</servlet-name>
        <servlet-class>com.gymmax.controller.AdminClasesServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DashboardSocioServlet</servlet-name>
        <servlet-class>com.gymmax.controller.DashboardSocioServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>MisReservasServlet</servlet-name>
        <servlet-class>com.gymmax.controller.MisReservasServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ContactoServlet</servlet-name>
        <url-pattern>/ContactoServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutController</servlet-name>
        <url-pattern>/LogoutController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RegistroServlet</servlet-name>
        <url-pattern>/RegistroServlet</url-pattern>
    </servlet-mapping>
   <servlet-mapping>
        <servlet-name>CarritoServlet</servlet-name>
        <url-pattern>/Carrito</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PagoServlet</servlet-name>
        <url-pattern>/ProcesarPago</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReservaServlet</servlet-name>
        <url-pattern>/Reserva</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminSociosServlet</servlet-name>
        <url-pattern>/AdminSocios</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminClasesServlet</servlet-name>
        <url-pattern>/AdminClasesServlet</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>DashboardSocioServlet</servlet-name>
        <servlet-class>com.gymmax.controller.DashboardSocioServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardSocioServlet</servlet-name>
        <url-pattern>/DashboardSocio</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>MisReservasServlet</servlet-name>
        <url-pattern>/MisReservas</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
